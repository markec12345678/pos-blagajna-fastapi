# ── POS Restaurant – Environment Variables ──
# Copy this to .env and adjust

# Database (default: SQLite at ./pos.db)
# For PostgreSQL:
# DATABASE_URL=postgresql://pos:pos_secret_2026@postgres:5432/pos
DATABASE_URL=sqlite:///./pos.db

# CORS origins (JSON array or comma-separated)
# CORS_ORIGINS=["https://pos.example.com"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Secret key for JWT tokens (CHANGE in production!)
SECRET_KEY=pos-secret-key-change-in-production

# App name
APP_NAME=POS Restaurant

# Debug mode
DEBUG=true

# POS DB path (SQLite only, used by database.py fallback)
POS_DB_PATH=./pos.db
